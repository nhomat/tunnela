# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-only, never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — Developers > API keys
STRIPE_SECRET_KEY=
# Developers > Webhooks > Signing secret
STRIPE_WEBHOOK_SECRET=
# Price IDs for each recurring monthly plan (Products > pricing)
STRIPE_PRICE_CABINET=
STRIPE_PRICE_PORTEFEUILLE=
STRIPE_PRICE_FONCIERE=
# Price ID for the Coop add-on (multi-user/team sharing)
STRIPE_PRICE_COOP_ADDON=

# Resend — for deadline alert emails and the contact form
RESEND_API_KEY=
ALERT_FROM_EMAIL="Tunnela <alertes@tunnela.fr>"
# Inbox that receives "book a call" form submissions
CONTACT_EMAIL="contact@tunnela.fr"

# Secret shared with Vercel Cron to authorize /api/cron/alertes
CRON_SECRET=

# Public URL of the deployed app (used in emails and Stripe redirects)
NEXT_PUBLIC_APP_URL=https://tunnela.fr
